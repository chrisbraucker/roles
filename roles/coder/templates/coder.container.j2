#jinja2: trim_blocks:True,lstrip_blocks:True
# {{ ansible_managed }}
[Unit]
Description=Coder management interface, ref: {{ coder_image_ref }}
Wants=network-online.target
After=network-online.target

[Service]
Restart={{ coder_restart }}
TimeoutStartSec={{ coder_timeout_start }}
TimeoutStopSec={{ coder_timeout_stop }}

[Container]
Image={{ coder_image_repo }}:{{ coder_image_ref }}
Exec=server
User={{ coder_container_user }}:{{ coder_container_group }}
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=true
{% if coder_memory is not none %}
Memory={{ coder_memory }}
{% endif %}
EnvironmentFile={{ coder_env_file }}
Volume={{ coder_cache_dir }}:/home/coder/.cache:Z
{% for network in coder_networks %}
Network={{ network }}
{% endfor %}
{% for alias in coder_network_aliases %}
NetworkAlias={{ alias }}
{% endfor %}
DropCapability=all

[Install]
WantedBy=multi-user.target
