#jinja2: trim_blocks:True,lstrip_blocks:True
# {{ ansible_managed }}
{% macro systemd_env_value(value) -%}
"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') }}"
{%- endmacro %}
CODER_ACCESS_URL={{ systemd_env_value(coder_access_url) }}
{% if coder_wildcard_access_url is not none %}
CODER_WILDCARD_ACCESS_URL={{ systemd_env_value(coder_wildcard_access_url) }}
{% endif %}
CODER_HTTP_ADDRESS={{ systemd_env_value(coder_http_address) }}
CODER_TLS_ENABLE={{ coder_tls_enable | bool | ternary('true', 'false') }}
CODER_REDIRECT_TO_ACCESS_URL={{ coder_redirect_to_access_url | bool | ternary('true', 'false') }}
CODER_DERP_FORCE_WEBSOCKETS={{ coder_derp_force_websockets | bool | ternary('true', 'false') }}
CODER_PROVISIONER_DAEMONS={{ coder_provisioner_daemons }}
CODER_PG_CONNECTION_URL={{ systemd_env_value(coder_pg_connection_url) }}
CODER_CACHE_DIRECTORY=/home/coder/.cache/coder
CODER_DISABLE_PASSWORD_AUTH={{ coder_disable_password_auth | bool | ternary('true', 'false') }}
CODER_SECURE_AUTH_COOKIE={{ coder_secure_auth_cookie | bool | ternary('true', 'false') }}
CODER_HOST_PREFIX_COOKIE={{ coder_host_prefix_cookie | bool | ternary('true', 'false') }}
CODER_DISABLE_PATH_APPS={{ coder_disable_path_apps | bool | ternary('true', 'false') }}
CODER_TELEMETRY_ENABLE={{ coder_telemetry_enable | bool | ternary('true', 'false') }}
CODER_UPDATE_CHECK={{ coder_update_check | bool | ternary('true', 'false') }}
