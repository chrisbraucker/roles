#jinja2: trim_blocks:True,lstrip_blocks:True
#!/bin/sh
# {{ ansible_managed }}

set -eu

{% if nginx_container_gid is defined and nginx_container_gid is not none and (nginx_container_gid | string | length > 0) %}
for root in "{{ certbot_config_dir }}/live" "{{ certbot_config_dir }}/archive"; do
    if [ -d "$root" ]; then
        chgrp -R "{{ nginx_container_gid }}" "$root"
        chmod -R g+r "$root"
        find "$root" -type d -exec chmod g+x {} +
    fi
done
{% endif %}

exec /usr/bin/systemctl reload {{ certbot_reload_service_name }}
