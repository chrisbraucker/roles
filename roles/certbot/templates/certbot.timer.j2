[Unit]
Description=Schedule certbot renewal runs

[Timer]
OnCalendar={{ certbot_timer_on_calendar }}
RandomizedDelaySec={{ certbot_timer_randomized_delay_sec }}
Persistent={{ 'true' if certbot_timer_persistent else 'false' }}

[Install]
WantedBy=timers.target
