#jinja2: trim_blocks:True,lstrip_blocks:True
# {{ ansible_managed }}
server {
    listen {{ nginx_global_https_redirect_http_port }} default_server;
    {% if nginx_global_https_redirect_http_ipv6 -%}
    listen [::]:{{ nginx_global_https_redirect_http_port }} default_server;
    {% endif -%}
    server_name _;
    {% for limit in nginx_global_https_redirect_limit_req | default([]) %}
    limit_req zone={{ limit.zone }}{% if limit.burst is defined %} burst={{ limit.burst }}{% endif %}{% if limit.delay is defined %} delay={{ limit.delay }}{% elif limit.nodelay | default(false) %} nodelay{% endif %};
    {% endfor %}
    {% for limit in nginx_global_https_redirect_limit_conn | default([]) %}
    limit_conn {{ limit.zone }} {{ limit.count }};
    {% endfor %}

    {% if nginx_certbot_http_01_enabled | bool -%}
    location ^~ /.well-known/acme-challenge/ {
        root {{ nginx_certbot_http_01_webroot }};
        default_type text/plain;
        try_files $uri =404;
    }
    {%- endif %}

    location / {
        return 308 https://$host$request_uri;
    }
}
