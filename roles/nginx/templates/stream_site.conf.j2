#jinja2: trim_blocks:True,lstrip_blocks:True
# {{ ansible_managed }}
{% if item.upstream_servers is defined %}
upstream {{ item.name }}_upstream {
    {% for server in item.upstream_servers %}
    server {{ server }};
    {% endfor %}
}
{% endif %}

server {
    listen {{ item.listen }};
    {% if item.proxy_timeout is defined %}
    proxy_timeout {{ item.proxy_timeout }};
    {% endif %}
    {% if item.proxy_connect_timeout is defined %}
    proxy_connect_timeout {{ item.proxy_connect_timeout }};
    {% endif %}
    proxy_pass {{ item.proxy_pass | default(item.name ~ "_upstream") }};
    {% if item.extra_config is defined %}
{{ item.extra_config | indent(4, true) }}
    {% endif %}
}
