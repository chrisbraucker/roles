#jinja2: trim_blocks:True,lstrip_blocks:True
# {{ ansible_managed }}
{% set server_names = item.server_name if item.server_name is sequence and item.server_name is not string else [item.server_name] %}
{% set tls_certificate_name = item.tls_certificate_name | default('') %}
{% set use_default_limits = item.use_default_limits | default(nginx_http_site_use_default_limits) %}
{% set server_limit_req = item.limit_req | default(nginx_http_site_default_limit_req if use_default_limits else []) %}
{% set server_limit_conn = item.limit_conn | default(nginx_http_site_default_limit_conn if use_default_limits else []) %}
{% if tls_certificate_name | length > 0 %}
{% set tls_certificate = item.tls_certificate | default(nginx_letsencrypt_live_dir ~ '/' ~ tls_certificate_name ~ '/fullchain.pem') %}
{% set tls_certificate_key = item.tls_certificate_key | default(nginx_letsencrypt_live_dir ~ '/' ~ tls_certificate_name ~ '/privkey.pem') %}
{% set tls_trusted_certificate = item.tls_trusted_certificate | default(item.tls_certificate_chain | default(nginx_letsencrypt_live_dir ~ '/' ~ tls_certificate_name ~ '/chain.pem')) %}
{% endif %}
server {
    {% if item.listen_http | default(false) %}
    listen {{ item.listen_http_port | default(80) }};
    {% if item.listen_http_ipv6 | default(true) %}
    listen [::]:{{ item.listen_http_port | default(80) }};
    {% endif %}
    {% endif %}
    {% if item.listen_https | default(false) %}
    listen {{ item.listen_https_port | default(443) }} ssl;
    {% if item.listen_https_ipv6 | default(true) %}
    listen [::]:{{ item.listen_https_port | default(443) }} ssl;
    {% endif %}
    http2 on;
    ssl_certificate {{ tls_certificate if tls_certificate_name | length > 0 else item.tls_certificate }};
    ssl_certificate_key {{ tls_certificate_key if tls_certificate_name | length > 0 else item.tls_certificate_key }};
    {% if item.tls_trusted_certificate is defined or item.tls_certificate_chain is defined or tls_certificate_name | length > 0 %}
    ssl_trusted_certificate {{ tls_trusted_certificate if tls_certificate_name | length > 0 else item.tls_trusted_certificate | default(item.tls_certificate_chain) }};
    {% endif %}
    {% if nginx_ssl_stapling_enabled | bool %}
    ssl_stapling on;
    ssl_stapling_verify {{ 'on' if nginx_ssl_stapling_verify else 'off' }};
    resolver {{ nginx_ssl_stapling_resolver | join(' ') }}{% if nginx_ssl_stapling_resolver_valid | length > 0 %} valid={{ nginx_ssl_stapling_resolver_valid }}{% endif %};
    {% endif %}
    {% endif %}
    server_name {{ server_names | join(' ') }};

    {% if item.client_max_body_size is defined %}
    client_max_body_size {{ item.client_max_body_size }};
    {% endif %}
    {% if item.root is defined %}
    root {{ item.root }};
    {% endif %}
    {% if item.index is defined %}
    index {{ item.index }};
    {% endif %}
    {% if item.hsts | default(nginx_http_site_hsts_default) %}
    add_header Strict-Transport-Security "{{ item.hsts_header_value | default(nginx_http_site_hsts_header_value) }}" always;
    {% endif %}
    {% for limit in server_limit_req %}
    limit_req zone={{ limit.zone }}{% if limit.burst is defined %} burst={{ limit.burst }}{% endif %}{% if limit.delay is defined %} delay={{ limit.delay }}{% elif limit.nodelay | default(false) %} nodelay{% endif %};
    {% endfor %}
    {% for limit in server_limit_conn %}
    limit_conn {{ limit.zone }} {{ limit.count }};
    {% endfor %}

    {% for location in item.locations | default([{'path': '/', 'proxy_pass': item.upstream, 'websocket': item.websocket | default(false)}]) %}
    location {{ location.path | default('/') }} {
        {% if location.gzip_off | default(false) %}
        gzip off;
        {% endif %}
        {% for limit in location.limit_req | default([]) %}
        limit_req zone={{ limit.zone }}{% if limit.burst is defined %} burst={{ limit.burst }}{% endif %}{% if limit.delay is defined %} delay={{ limit.delay }}{% elif limit.nodelay | default(false) %} nodelay{% endif %};
        {% endfor %}
        {% for limit in location.limit_conn | default([]) %}
        limit_conn {{ limit.zone }} {{ limit.count }};
        {% endfor %}
        {% if location.proxy_pass is defined %}
        proxy_pass {{ location.proxy_pass }};
        proxy_http_version 1.1;
        {% if location.proxy_buffering is defined %}
        proxy_buffering {{ 'on' if location.proxy_buffering else 'off' }};
        {% endif %}
        {% if location.proxy_request_buffering is defined %}
        proxy_request_buffering {{ 'on' if location.proxy_request_buffering else 'off' }};
        {% endif %}
        {% if location.proxy_send_timeout is defined %}
        proxy_send_timeout {{ location.proxy_send_timeout }};
        {% endif %}
        {% if location.proxy_read_timeout is defined %}
        proxy_read_timeout {{ location.proxy_read_timeout }};
        {% endif %}
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        {% if location.websocket | default(false) %}
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        {% endif %}
        {% endif %}
        {% if location.grpc_pass is defined %}
        grpc_pass {{ location.grpc_pass }};
        {% for header_name, header_value in ({
          'Host': '$host',
          'X-Forwarded-Proto': '$scheme',
          'X-Forwarded-For': '$proxy_add_x_forwarded_for',
          'X-Forwarded-Host': '$host',
          'X-Forwarded-Port': '$server_port'
        } | combine(location.grpc_set_headers | default({}))).items() %}
        grpc_set_header {{ header_name }} {{ header_value }};
        {% endfor %}
        {% if location.grpc_read_timeout is defined %}
        grpc_read_timeout {{ location.grpc_read_timeout }};
        {% endif %}
        {% if location.grpc_send_timeout is defined %}
        grpc_send_timeout {{ location.grpc_send_timeout }};
        {% endif %}
        {% if location.grpc_connect_timeout is defined %}
        grpc_connect_timeout {{ location.grpc_connect_timeout }};
        {% endif %}
        {% endif %}
        {% if location.include_files is defined %}
        {% for include_file in location.include_files %}
        include {{ include_file }};
        {% endfor %}
        {% endif %}
        {% if location.extra_config is defined %}
{{ location.extra_config | indent(8, true) }}
        {% endif %}
    }
    {% endfor %}
    {% if item.extra_server_config is defined %}
{{ item.extra_server_config | indent(4, true) }}
    {% endif %}
}
