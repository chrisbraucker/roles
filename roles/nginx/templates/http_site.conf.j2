{% set server_names = item.server_name if item.server_name is sequence and item.server_name is not string else [item.server_name] %}
server {
    {% if item.listen_http | default(true) %}
    listen {{ item.listen_http_port | default(80) }};
    {% if item.listen_http_ipv6 | default(true) %}
    listen [::]:{{ item.listen_http_port | default(80) }};
    {% endif %}
    {% endif %}
    {% if item.listen_https | default(false) %}
    listen {{ item.listen_https_port | default(443) }} ssl http2;
    {% if item.listen_https_ipv6 | default(true) %}
    listen [::]:{{ item.listen_https_port | default(443) }} ssl http2;
    {% endif %}
    ssl_certificate {{ item.tls_certificate }};
    ssl_certificate_key {{ item.tls_certificate_key }};
    {% if item.tls_trusted_certificate is defined or item.tls_certificate_chain is defined %}
    ssl_trusted_certificate {{ item.tls_trusted_certificate | default(item.tls_certificate_chain) }};
    {% endif %}
    {% if nginx_ssl_stapling_enabled | bool %}
    ssl_stapling on;
    ssl_stapling_verify {{ 'on' if nginx_ssl_stapling_verify else 'off' }};
    resolver {{ nginx_ssl_stapling_resolver | join(' ') }}{% if nginx_ssl_stapling_resolver_valid | length > 0 %} valid={{ nginx_ssl_stapling_resolver_valid }}{% endif %};
    {% endif %}
    {% endif %}
    server_name {{ server_names | join(' ') }};

    {% if item.client_max_body_size is defined %}
    client_max_body_size {{ item.client_max_body_size }};
    {% endif %}
    {% if item.root is defined %}
    root {{ item.root }};
    {% endif %}
    {% if item.index is defined %}
    index {{ item.index }};
    {% endif %}
    {% if item.hsts | default(nginx_http_site_hsts_default) %}
    add_header Strict-Transport-Security "{{ item.hsts_header_value | default(nginx_http_site_hsts_header_value) }}" always;
    {% endif %}

    {% for location in item.locations | default([{'path': '/', 'proxy_pass': item.upstream, 'websocket': item.websocket | default(false)}]) %}
    location {{ location.path | default('/') }} {
        {% if location.gzip_off | default(false) %}
        gzip off;
        {% endif %}
        {% if location.proxy_pass is defined %}
        proxy_pass {{ location.proxy_pass }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        {% if location.websocket | default(false) %}
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        {% endif %}
        {% endif %}
        {% if location.include_files is defined %}
        {% for include_file in location.include_files %}
        include {{ include_file }};
        {% endfor %}
        {% endif %}
        {% if location.extra_config is defined %}
{{ location.extra_config | indent(8, true) }}
        {% endif %}
    }
    {% endfor %}

    {% if item.extra_server_config is defined %}
{{ item.extra_server_config | indent(4, true) }}
    {% endif %}
}
