[DEFAULT]
bantime     = {{ bastion_fail2ban_bantime }}
findtime    = {{ bastion_fail2ban_findtime }}
maxmatches  = {{ bastion_fail2ban_maxmatches }}
maxretry    = {{ bastion_fail2ban_maxretry }}

bantime.increment = {{ 'true' if bastion_fail2ban_bantime_increment else 'false' }}

ignoreip = {{ bastion_fail2ban_ignore_ips_default + bastion_fail2ban_ignore_ips | join (' ') }}

[sshd]
enabled = {{ 'true' if bastion_fail2ban_sshd_enabled else 'false' }}
mode    = normal
