# from https://packagecloud.io/crowdsec/crowdsec/install#manual-rpm
[packagecloud-crowdsec]
name=packagecloud-crowdsec
baseurl=https://packagecloud.io/crowdsec/crowdsec/el/$releasever/$basearch
repo_gpgcheck=1
gpgcheck=1
enabled=1
gpgkey=file:///var/cache/gpg/packagecloud-crowdsec
       file:///var/cache/gpg/packagecloud-crowdsec-B78D1222C9AD2D5D.pub
       file:///var/cache/gpg/packagecloud-crowdsec-FED78314A2468CCF.pub
       file:///var/cache/gpg/packagecloud-crowdsec-EDE2C695EC9A5A5C.pub
sslverify=1
sslcacert=/etc/pki/tls/certs/ca-bundle.crt
metadata_expire=300

[packagecloud-crowdsec-source]
name=packagecloud-crowdsec-source
baseurl=https://packagecloud.io/crowdsec/crowdsec/el/$releasever/SRPMS
repo_gpgcheck=1
gpgcheck=1
enabled=1
gpgkey=file:///var/cache/gpg/packagecloud-crowdsec
       file:///var/cache/gpg/packagecloud-crowdsec-B78D1222C9AD2D5D.pub
       file:///var/cache/gpg/packagecloud-crowdsec-FED78314A2468CCF.pub
       file:///var/cache/gpg/packagecloud-crowdsec-EDE2C695EC9A5A5C.pub
sslverify=1
sslcacert=/etc/pki/tls/certs/ca-bundle.crt
metadata_expire=300
