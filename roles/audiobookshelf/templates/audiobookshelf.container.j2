#jinja2: trim_blocks:True,lstrip_blocks:True
# {{ ansible_managed }}
[Unit]
Description=Quadlet audiobookshelf service, ref: {{ audiobookshelf_image_ref }}
[Service]
Restart=on-failure

[Container]
Image={{ audiobookshelf_image_repo }}:{{ audiobookshelf_image_ref }}
LogDriver=journald
User={{ audiobookshelf_container_uid }}:{{ audiobookshelf_container_gid }}
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=true
{% if audiobookshelf_memory is not none %}
Memory={{ audiobookshelf_memory }}
{% endif %}
{% if audiobookshelf_port is not none %}
Environment=PORT={{ audiobookshelf_port }}
{% endif %}
Volume={{ (audiobookshelf_root, "audiobooks") | path_join }}:/audiobooks:Z
Volume={{ (audiobookshelf_root, "config") | path_join }}:/config:Z
Volume={{ (audiobookshelf_root, "metadata") | path_join }}:/metadata:Z
{% for network in audiobookshelf_networks %}
Network={{ network }}
{% endfor %}
{% for alias in audiobookshelf_network_aliases %}
NetworkAlias={{ alias }}
{% endfor %}
DropCapability=all

[Install]
WantedBy=multi-user.target
