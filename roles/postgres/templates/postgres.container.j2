#jinja2: trim_blocks:True,lstrip_blocks:True
# {{ ansible_managed }}
[Unit]
Description=PostgreSQL database, ref: {{ postgres_image_ref }}
Wants=network-online.target
After=network-online.target

[Service]
Restart={{ postgres_restart }}
TimeoutStartSec={{ postgres_timeout_start }}
TimeoutStopSec={{ postgres_timeout_stop }}

[Container]
Image={{ postgres_image_repo }}:{{ postgres_image_ref }}
User={{ postgres_container_user }}:{{ postgres_container_group }}
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=true
{% if postgres_memory is not none %}
Memory={{ postgres_memory }}
{% endif %}
Environment=POSTGRES_USER={{ postgres_superuser_name }}
Volume={{ postgres_data_dir }}:/var/lib/postgresql/:Z
{% for network in postgres_networks %}
Network={{ network }}
{% endfor %}
{% for alias in postgres_network_aliases %}
NetworkAlias={{ alias }}
{% endfor %}
DropCapability=all
HealthCmd=pg_isready -U {{ postgres_superuser_name }} || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=20s

[Install]
WantedBy=multi-user.target
