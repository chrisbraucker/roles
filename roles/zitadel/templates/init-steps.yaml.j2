#jinja2: trim_blocks:True,lstrip_blocks:True
# {{ ansible_managed }}
FirstInstance:
  Skip: false
  InstanceName: Zitadel
{% if zitadel_login_enabled | bool %}
  LoginClientPatPath: '{{ zitadel_login_client_pat_container_path }}'
{% endif %}
{% if zitadel_firstinstance_trusted_domains | length > 0 %}
  TrustedDomains:
{% for domain in zitadel_firstinstance_trusted_domains %}
    - '{{ domain }}'
{% endfor %}
{% endif %}
  Org:
    Human:
      UserName: '{{ zitadel_firstinstance_org_human_username }}'
      Password: '{{ zitadel_firstinstance_org_human_password }}'
{% if zitadel_login_enabled | bool %}
    LoginClient:
      Machine:
        Username: '{{ zitadel_firstinstance_loginclient_machine_username }}'
        Name: '{{ zitadel_firstinstance_loginclient_machine_name }}'
      Pat:
        ExpirationDate: '{{ zitadel_firstinstance_loginclient_pat_expiration_date }}'
{% endif %}
